<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_stat">

    <fragment
        android:id="@+id/navigation_splash"
        android:name="com.example.yeongkkuel.presentation.splash.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/navigation_login"
            app:popUpTo="@id/navigation_splash"
            app:popUpToInclusive="true"
            />
    </fragment>

    <fragment
        android:id="@+id/navigation_login"
        android:name="com.example.yeongkkuel.presentation.login.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_navigation_home"
            app:destination="@id/navigation_home"
            />
        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/navigation_signup"
            />
    </fragment>

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.yeongkkuel.presentation.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
    </fragment>

    <fragment
        android:id="@+id/navigation_signup"
        android:name="com.example.yeongkkuel.presentation.signup.SignupFragment"
        android:label="fragment_signup"
        tools:layout="@layout/fragment_signup">
        <action
            android:id="@+id/action_signupFragment_to_navigation_home"
            app:destination="@id/navigation_home"
            app:popUpTo="@id/navigation_login"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/categoryManageFragment"
        android:name="com.example.yeongkkuel.presentation.home.category.CategoryManageFragment"
        android:label="카테고리 관리"
        tools:layout="@layout/fragment_category_manage">
        <action
            android:id="@+id/action_categoryManageFragment_to_categoryAddFragment"
            app:destination="@id/categoryAddFragment" />
    </fragment>

    <fragment
        android:id="@+id/categoryAddFragment"
        android:name="com.example.yeongkkuel.presentation.home.category.CategoryAddFragment"
        android:label="카테고리 추가"
        tools:layout="@layout/fragment_category_add" />


    <fragment
        android:id="@+id/navigation_chat"
        android:name="com.example.yeongkkuel.presentation.chat.ChatFragment"
        android:label="fragment_chat"
        tools:layout="@layout/fragment_chat">
    </fragment>

    <fragment
        android:id="@+id/navigation_stat"
        android:name="com.example.yeongkkuel.presentation.stat.StatFragment"
        android:label="fragment_stat"
        tools:layout="@layout/fragment_stat">
    </fragment>

    <fragment
        android:id="@+id/navigation_my"
        android:name="com.example.yeongkkuel.presentation.my.MyFragment"
        android:label="fragment_my"
        tools:layout="@layout/fragment_my">
    </fragment>

</navigation>