<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="20"
    android:viewportHeight="20">

    <!-- Background Group -->
    <group
        android:name="backgroundGroup">
        <!-- Circle Background -->
        <path
            android:pathData="M10,10m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0"
            android:fillColor="?attr/colorControlActivated"/>
    </group>

    <!-- Lines Group -->
    <group
        android:name="linesGroup">
        <!-- Vertical Line -->
        <path
            android:pathData="M10,5V15"
            android:strokeLineJoin="round"
            android:strokeWidth="2"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"/>

        <!-- Horizontal Line -->
        <path
            android:pathData="M5,10H15"
            android:strokeLineJoin="round"
            android:strokeWidth="2"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"/>
    </group>

</vector>
