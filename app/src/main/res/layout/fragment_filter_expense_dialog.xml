<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomSheetLayout"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:background="@drawable/bg_chat_modal_bottom_sheet"
    android:orientation="vertical"
    android:paddingTop="34dp"
    android:paddingBottom="38dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_middle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <TextView
        android:id="@+id/tv_title_filter_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="하루 목표 지출액"
        android:textColor="@color/main1"
        android:textStyle="bold"
        style="@style/humm_semibo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_daily_goal_expense_min"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black3"
        style="@style/title_semib"
        android:textColorHint="@color/black2"
        android:hint="0"
        android:imeOptions="actionNext"
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_edittext_pw"
        app:layout_constraintEnd_toStartOf="@+id/tv_daily_goal_expense_min"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_filter_age" />

    <TextView
        android:id="@+id/tv_daily_goal_expense_min"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="원"
        android:textColor="@color/black"
        style="@style/body_regula"
        android:layout_marginEnd="28dp"
        app:layout_constraintEnd_toEndOf="@+id/gl_middle"
        app:layout_constraintBottom_toBottomOf="@+id/et_daily_goal_expense_min" />

    <TextView
        android:id="@+id/tv_hyphen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textColor="@color/black"
        style="@style/humm_semibo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/et_daily_goal_expense_min" />

    <EditText
        android:id="@+id/et_daily_goal_expense_max"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black3"
        style="@style/title_semib"
        android:textColorHint="@color/black2"
        android:hint="0"
        android:imeOptions="actionNext"
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="28dp"
        android:background="@drawable/bg_edittext_pw"
        app:layout_constraintStart_toStartOf="@+id/gl_middle"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_filter_age" />

    <TextView
        android:id="@+id/tv_daily_goal_expense_max"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="원"
        android:textColor="@color/black"
        style="@style/body_regula"
        app:layout_constraintStart_toEndOf="@+id/et_daily_goal_expense_max"
        app:layout_constraintBottom_toBottomOf="@+id/et_daily_goal_expense_min" />

    <kr.co.prnd.slider.FlexibleStepRangeSlider
        android:id="@+id/rangeSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="20dp"
        app:thumbColorActive="@color/white"
        app:thumbColorInactive="@color/white"
        app:thumbElevationActive="2dp"
        app:thumbElevationInactive="4dp"
        app:thumbRadiusActive="14dp"
        app:thumbRadiusInactive="12dp"
        app:thumbStrokeColorActive="@color/main1"
        app:thumbStrokeColorInactive="@color/main2"
        app:thumbStrokeWidthActive="2dp"
        app:thumbStrokeWidthInactive="2dp"
        app:tickColorActive="@color/main1"
        app:tickColorInactive="@color/main1"
        app:tickVisible="true"
        app:trackColorActive="@color/main1"
        app:trackColorInactive="@color/main1"
        app:trackHeight="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_daily_goal_expense_min"/>

</androidx.constraintlayout.widget.ConstraintLayout>
