<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="328dp"
    android:layout_height="276dp"
    android:orientation="vertical"
    android:paddingTop="28dp"
    android:paddingBottom="12dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="@drawable/bg_chat_room_dialog">

    <ImageView
        android:id="@+id/iv_thumbnail_chat_room"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_thumbnail_chat_room"
        android:clipToOutline="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title_chat_room"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="채팅방 1"
        android:textColor="@color/main1"
        android:textStyle="bold"
        style="@style/humm_semibo"
        android:gravity="center"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_thumbnail_chat_room" />

    <TextView
        android:id="@+id/tv_content_chat_room_exit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="방장이 나가면 채팅방이 사라져요\n채팅방을 없애시겠어요?"
        android:textColor="@color/black"
        style="@style/body_medium"
        android:gravity="center"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_chat_room" />

    <TextView
        android:id="@+id/btn_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="취소"
        android:textColor="@color/black"
        style="@style/body_medium"
        android:gravity="center"
        android:paddingStart="58dp"
        android:paddingEnd="58dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_btn_dialog_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/btn_exit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="없애기"
        android:textColor="@color/white"
        style="@style/body_medium"
        android:gravity="center"
        android:paddingStart="51dp"
        android:paddingEnd="51dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_btn_dialog_exit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
