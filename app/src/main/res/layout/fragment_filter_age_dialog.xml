<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomSheetLayout"
    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:background="@drawable/bg_chat_modal_bottom_sheet"
    android:orientation="vertical"
    android:paddingTop="34dp"
    android:paddingBottom="38dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.25" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.75" />

    <TextView
        android:id="@+id/tv_title_filter_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="연령대"
        android:textColor="@color/main1"
        android:textStyle="bold"
        style="@style/humm_semibo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btn_age_14_19"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="14~19세"
        android:textColor="@color/black"
        style="@style/body_regula"
        android:layout_marginTop="28dp"
        app:layout_constraintStart_toStartOf="@+id/gl_start"
        app:layout_constraintEnd_toEndOf="@+id/gl_start"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_filter_age"/>

    <TextView
        android:id="@+id/btn_age_30"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="30대"
        android:textColor="@color/black"
        style="@style/body_regula"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="@+id/gl_start"
        app:layout_constraintEnd_toEndOf="@+id/gl_start"
        app:layout_constraintTop_toBottomOf="@+id/btn_age_14_19"/>

    <TextView
        android:id="@+id/btn_age_50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50대"
        android:textColor="@color/black"
        style="@style/body_regula"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="@+id/gl_start"
        app:layout_constraintEnd_toEndOf="@+id/gl_start"
        app:layout_constraintTop_toBottomOf="@+id/btn_age_30"/>

    <TextView
        android:id="@+id/btn_age_20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="20대"
        android:textColor="@color/black"
        style="@style/body_regula"
        android:layout_marginTop="28dp"
        app:layout_constraintStart_toStartOf="@+id/gl_end"
        app:layout_constraintEnd_toEndOf="@+id/gl_end"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_filter_age"/>

    <TextView
        android:id="@+id/btn_age_40"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="40대"
        android:textColor="@color/black"
        style="@style/body_regula"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="@+id/gl_end"
        app:layout_constraintEnd_toEndOf="@+id/gl_end"
        app:layout_constraintTop_toBottomOf="@+id/btn_age_20"/>

    <TextView
        android:id="@+id/btn_age_60"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="60세 이상"
        android:textColor="@color/black"
        style="@style/body_regula"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="@+id/gl_end"
        app:layout_constraintEnd_toEndOf="@+id/gl_end"
        app:layout_constraintTop_toBottomOf="@+id/btn_age_40"/>

</androidx.constraintlayout.widget.ConstraintLayout>
