<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="328dp"
    android:layout_height="188dp"
    android:background="@drawable/bg_box_white">

    <TextView
        android:id="@+id/tv_purchase_failure1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="잠깐!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/main1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="36dp" />

    <TextView
        android:id="@+id/tv_purchase_failure_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="리워드가 부족해서 구매하지 못했어요."
        android:textSize="15sp"
        android:textStyle="normal"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/tv_purchase_failure1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/btn_failure_check"
        android:layout_width="290dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:background="@drawable/bg_box_purple2"
        android:text="확인"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="normal"
        app:layout_constraintTop_toBottomOf="@id/tv_purchase_failure_message"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <View
        android:layout_width="0dp"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_failure_check"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
