<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <include
        android:id="@+id/include_topbar"
        layout="@layout/fragment_topbar_store"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/img_bird_background"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/bg_home"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/include_topbar">

        <!-- 상단 영역 -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gl_top_section"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:columnCount="2"
            app:layout_constraintTop_toTopOf="@id/img_bird_background"
            app:rowCount="1">

            <!-- 그네 -->

            <!-- 둥지 -->
            <FrameLayout
                android:id="@+id/img_store_swing_area"
                android:layout_width="180dp"
                android:layout_height="180dp"
                app:layout_column="0"
                app:layout_columnWeight="1"
                app:layout_row="0">

                <ImageView
                    android:id="@+id/img_store_swing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/transparent_background" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/img_store_nest_area"
                android:layout_width="180dp"
                android:layout_height="180dp"
                app:layout_columnWeight="1">

                <ImageView
                    android:id="@+id/img_store_nest"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/transparent_background"
                    app:layout_column="1"
                    app:layout_row="0" />
            </FrameLayout>
        </androidx.gridlayout.widget.GridLayout>

        <!-- 하단 영역 -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gl_bottom_section"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            app:columnCount="2"
            app:layout_constraintTop_toBottomOf="@id/gl_top_section"
            app:rowCount="1">

            <FrameLayout
                android:id="@+id/img_store_toy_area"
                android:layout_width="180dp"
                android:layout_height="140dp"
                app:layout_column="0"
                app:layout_columnWeight="1"
                app:layout_row="0">

                <ImageView
                    android:id="@+id/img_store__toy"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/transparent_background" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/img_store_bowl_area"
                android:layout_width="180dp"
                android:layout_height="140dp"
                app:layout_columnWeight="1">

                <ImageView
                    android:id="@+id/img_store__bowl"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/transparent_background" />
            </FrameLayout>
        </androidx.gridlayout.widget.GridLayout>

        <!-- 새 이미지 -->
        <ImageView
            android:id="@+id/img_home_bird"
            android:layout_width="164dp"
            android:layout_height="164dp"
            android:src="@drawable/img_bird"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 코인 -->
        <LinearLayout
            android:id="@+id/ly_coin_bar"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_box_white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ic_coin"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_coin" />

            <TextView
                android:id="@+id/tv_coin"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:text=" "
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="normal" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-24dp"
        android:background="@drawable/bg_state_bottomsheet"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingHorizontal="@dimen/space_median"
        android:paddingTop="@dimen/space_median"
        app:layout_constraintTop_toBottomOf="@id/img_bird_background">

        <!-- 탭 레이아웃 -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_box_white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tabGravity="center"
            app:tabIndicatorColor="@color/main3"
            app:tabPaddingStart="0dp"
            app:tabPaddingEnd="0dp"
            app:tabIndicatorHeight="0dp"
            android:backgroundTint="@color/transparent"/>

        <!-- 가로 스크롤  -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_store_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:scrollbars="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/tab_layout" />

        <ImageView
            android:id="@+id/img_purchase_icon"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/ic_store_topurchase"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/img_save_icon"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/ic_store_tosave"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>