<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingVertical="2dp">

    <ImageView
        android:id="@+id/iv_startPoint"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/bg_point_green"
        android:clipToOutline="true"/>


    <TextView
        android:id="@+id/tv_spendingCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_startPoint"
        tools:text = "간식/음료"
        android:layout_marginStart="@dimen/space_x_small"
        style="@style/body_regula"/>

    <TextView
        android:id="@+id/tv_spendingMoney"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_spendingCategory"
        tools:text = "12,910원"
        app:layout_goneMarginStart="@dimen/space_x_small"
        tools:textColor="@color/green"
        android:layout_marginStart="@dimen/space_x_small"
        style="@style/body_regula"/>


</androidx.constraintlayout.widget.ConstraintLayout>