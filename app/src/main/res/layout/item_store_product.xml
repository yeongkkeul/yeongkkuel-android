<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/bg_product_box"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:src="@drawable/bg_box_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/img_store_product"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/img_product_bowl1"
        app:layout_constraintEnd_toEndOf="@id/bg_product_box"
        app:layout_constraintStart_toStartOf="@id/bg_product_box"
        app:layout_constraintTop_toTopOf="@id/bg_product_box" />

    <LinearLayout
        android:id="@+id/ly_coin_price"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="30dp"
        app:layout_constraintStart_toStartOf="@id/bg_product_box"
        app:layout_constraintTop_toBottomOf="@id/img_store_product">

        <!-- 코인 아이콘 -->
        <ImageView
            android:id="@+id/img_coin_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/ic_coin" />

        <!-- 가격 -->
        <TextView
            android:id="@+id/tv_product_price"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:text="128"
            android:textColor="@color/main1"
            android:textSize="12sp"
            android:textStyle="normal" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_store_product_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="핑크 밥그릇"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:textStyle="normal"
        app:layout_constraintTop_toBottomOf="@id/ly_coin_price"
        app:layout_constraintStart_toStartOf="@id/bg_product_box"
        app:layout_constraintEnd_toEndOf="@id/bg_product_box" />
    <ImageView
        android:id="@+id/img_store_collect"
        android:layout_width="100dp"
        android:layout_height="128dp"
        android:visibility="gone"
        android:src="@drawable/img_store_choose"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
