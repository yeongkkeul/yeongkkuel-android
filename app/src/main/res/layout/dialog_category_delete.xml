<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="328dp"
    android:layout_height="160dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_category_limit_dialog"
    android:padding="10dp"
    android:elevation="10dp"
    android:layout_gravity="center">

    <TextView
        android:id="@+id/tv_delete_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="해당 카테고리를 삭제할까요?"
        android:textColor="@color/black"
        style="@style/body_medium"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toBottomOf="@id/tv_delete_message">

        <TextView
            android:id="@+id/tv_cancel_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginRight="@dimen/space_x_small"
            android:background="@drawable/bg_button_gray"
            android:textColor="@color/black"
            android:clickable="true"
            android:focusable="true"
            android:text="취소"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_delete_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="삭제"
            android:gravity="center"
            android:padding="10dp"
            android:background="@drawable/bg_button_red"
            android:textColor="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:layout_weight="1" /> <!-- 동일 비율 -->

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>