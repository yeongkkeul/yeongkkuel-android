<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <GridLayout
        android:id="@+id/gridColorPalette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_palette_frame"
        android:columnCount="5"
        android:padding="10dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 색상 아이템 -->

        <!-- 1열 -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/red1" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/red2"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/pink3"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/purple4"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/purple5"/>

        <!-- 2열 -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/blue6"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/blue7"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/blue8"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/green9"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/green10"/>

        <!-- 3열 -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/green11"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/green12"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/yellow13"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/orange14"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_color_circle"
            android:layout_margin="4dp"
            android:backgroundTint="@color/orange15"/>
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
