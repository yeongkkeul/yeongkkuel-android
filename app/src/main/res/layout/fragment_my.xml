<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 앱바 (기존 코드 유지) -->
    <include
        android:id="@+id/include_topbar"
        layout="@layout/fragment_topbar_morebell"
        app:layout_constraintTop_toTopOf="parent" />


    <ScrollView
        android:id="@+id/scroll_mypage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/include_topbar"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <!-- 스크롤 내부 LinearLayout -->
        <LinearLayout
            android:id="@+id/layout_mypage_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_small"
            android:paddingBottom="80dp">

        <!-- 프로필 섹션 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_median"
            >

            <!-- 프로필 이미지 -->
            <ImageView
                android:id="@+id/iv_profile"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_my_profile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="10dp"/>

            <!-- 닉네임 -->
            <TextView
                android:id="@+id/tv_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_large"
                android:text="0끌해서집산다"
                style="@style/humm_medium"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/iv_profile"
                app:layout_constraintTop_toTopOf="parent"
                />

            <!-- 나이 -->
            <TextView
                android:id="@+id/tv_age"
                style="@style/small_regul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="20대"
                android:textColor="@color/main1"
                app:layout_constraintStart_toStartOf="@id/tv_nickname"
                app:layout_constraintTop_toBottomOf="@id/tv_nickname" />

            <!-- 중간 점 (·) -->
            <TextView
                android:id="@+id/tv_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=" · "
                android:textColor="@color/main1"
                style="@style/small_regul"
                app:layout_constraintStart_toEndOf="@id/tv_age"
                app:layout_constraintTop_toBottomOf="@id/tv_nickname" />

            <!-- 직업 -->
            <TextView
                android:id="@+id/tv_job"
                style="@style/small_regul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="직장인"
                android:textColor="@color/main1"
                app:layout_constraintStart_toEndOf="@id/tv_dot"
                app:layout_constraintTop_toBottomOf="@id/tv_nickname" />

            <!-- 이메일 -->
            <TextView
                android:id="@+id/tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="example@naver.com"
                android:textColor="@color/black2"
                style="@style/small_regul"
                app:layout_constraintStart_toStartOf="@id/tv_age"
                app:layout_constraintTop_toBottomOf="@id/tv_age" />

            <!-- 프로필 수정 버튼 -->

            <TextView
                android:id="@+id/tv_profile_edit"
                android:layout_width="match_parent"
                android:layout_marginStart="108dp"
                android:layout_height="30dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="8dp"

                android:background="@drawable/bg_profile_edit"
                android:gravity="center"
                android:text="프로필 수정"
                android:textColor="@color/black"
                style="@style/small_regul"
                app:layout_constraintStart_toStartOf="@id/tv_email"
                app:layout_constraintTop_toBottomOf="@id/tv_email"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginVertical="22dp"
            android:background="@color/main2" />

        <!-- 나의 하루 목표 지출액 (타이틀 + 수정) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_large">

            <TextView
                android:id="@+id/tv_daily_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="나의 하루 목표 지출액"
                android:textColor="@color/black"
                style="@style/body_medium"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_daily_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="수정"
                android:clickable="true"
                android:textColor="@color/sub1"
                style="@style/small_semib"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 일일 목표 2개 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:paddingHorizontal="@dimen/space_median"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- 왼쪽 카드 -->
            <LinearLayout
                android:layout_width="156dp"
                android:layout_height="76dp"
                android:layout_marginEnd="@dimen/space_x_small"
                android:layout_weight="1"
                android:background="@drawable/bg_my_box"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_daily_limit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-원"
                    style="@style/humm_semibo"
                    android:textColor="@color/main1"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="일일 목표 지출 한도"
                    style="@style/tiny_medium"
                    android:textColor="@color/black"
                     />
            </LinearLayout>

            <!-- 오른쪽 카드 -->
            <LinearLayout
                android:layout_width="156dp"
                android:layout_height="76dp"
                android:layout_marginStart="@dimen/space_x_small"
                android:layout_weight="1"
                android:background="@drawable/bg_my_box"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_daily_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-%"
                    style="@style/humm_semibo"
                    android:textColor="@color/main1"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="일주일 기준 목표달성률"
                    android:textColor="@color/black"
                    style="@style/tiny_medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- 나의 리워드 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_median"
            android:layout_marginTop="@dimen/space_small">

            <TextView
                android:id="@+id/tv_reward_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="나의 리워드"
                android:textColor="@color/black"
                style="@style/body_medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_reward_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:clickable="true"
                android:src="@drawable/ic_my_reward_detail"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_my_box"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_reward_title">


                <ImageView
                    android:id="@+id/iv_reward_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_coin_small"
                     />
                <TextView
                    android:id="@+id/tv_reward_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3122"
                    style="@style/humm_semibo"
                    android:textColor="@color/main1"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginVertical="15dp"
            android:background="@color/main2" />

        <!-- 메뉴 리스트 -->
        <TextView
            android:id="@+id/tv_invite_friend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="15dp"
            android:text="친구 초대"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tv_faq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:text="자주 묻는 질문"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tv_support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:text="고객 지원"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tv_terms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:text="서비스 이용 약관"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tv_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="15dp"
            android:text="로그아웃"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tv_withdraw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="15dp"
            android:text="탈퇴하기"
            android:textColor="@color/black" />

    </LinearLayout>
</ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
