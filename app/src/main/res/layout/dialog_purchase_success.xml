<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="328dp"
    android:layout_height="292dp"
    android:background="@drawable/bg_box_white">

    <!-- 상품 이미지 -->
    <ImageView
        android:id="@+id/img_product"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/img_product_toy1"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 상품 이름 -->
    <TextView
        android:id="@+id/tv_product_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="탱탱볼"
        android:textSize="18sp"
        android:textStyle="normal"
        android:textColor="@color/main1"
        android:layout_marginStart="108dp"
        app:layout_constraintTop_toBottomOf="@id/img_product"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:id="@+id/ic_coin"
        android:src="@drawable/ic_coin"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/tv_product_name"
        app:layout_constraintTop_toBottomOf="@id/img_product"/>

    <!-- 상품 가격 -->
    <TextView
        android:id="@+id/tv_product_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="128"
        android:textSize="18sp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/img_product"
        app:layout_constraintStart_toEndOf="@id/ic_coin"
/>

    <!-- 구매 질문 -->
    <TextView
        android:id="@+id/tv_purchase_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="구매하시겠어요?"
        android:textSize="15sp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/tv_product_price"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 버튼 영역 -->
    <LinearLayout
        android:id="@+id/ly_buttons"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_purchase_question"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 취소 버튼 -->
        <FrameLayout
            android:layout_width="144dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/bg_purchase_cancel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_box_gray" />

            <TextView
                android:id="@+id/tv_purchase_cancel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="취소"
                android:textSize="15sp"
                android:textColor="@color/black" />
        </FrameLayout>

        <!-- 구매 버튼 -->
        <FrameLayout
            android:layout_width="144dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/bg_purchase_confirm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_box_purple" />

            <TextView
                android:id="@+id/tv_purchase_confirm"
                android:layout_width="147dp"
                android:layout_height="35dp"
                android:gravity="center"
                android:text="구매"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
